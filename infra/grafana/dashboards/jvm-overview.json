{
  "title": "JVM Overview",
  "uid": "mykart-jvm",
  "tags": ["mykart", "jvm"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Heap Used (MB)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\", service=~\"$service\"} / 1024 / 1024",
          "legendFormat": "{{service}} {{id}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "GC Pause Rate (ops/s)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_count{service=~\"$service\"}[1m])",
          "legendFormat": "{{service}} {{action}} {{cause}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Live Threads",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "jvm_threads_live_threads{service=~\"$service\"}",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{service=~\"$service\"}[1m])",
          "legendFormat": "{{service}} {{uri}} {{status}}"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "query": "label_values(jvm_memory_used_bytes, service)",
        "multi": true,
        "includeAll": true,
        "current": {"text": "All", "value": "$__all"}
      }
    ]
  }
}
